# Copia a .env y ajusta. Los valores de abajo son solo de desarrollo local.

# Puerto en el host del Postgres del docker-compose (5435)
DATABASE_URL="postgresql://intermediacion:intermediacion@localhost:5435/intermediacion?schema=public"

# API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN="http://localhost:4200"

# Secret de firma de JWT
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="8h"

# Tipo de IVA por defecto en las facturas de comisión.
# 0 = exportación (Canarias -> Península), que es el caso real de este negocio.
DEFAULT_TAX_PCT=0
